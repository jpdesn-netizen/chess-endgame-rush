# Copier en .env.production (build du site en ligne) et remplir.
# Ces valeurs sont PUBLIQUES (elles finissent dans le code du site) :
# ne JAMAIS mettre ici la clé secrète Supabase (sb_secret_… / service_role).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cloudflare Turnstile (anti-robots), facultatif : clé de SITE (pas la clé secrète)
VITE_TURNSTILE_SITEKEY=

# Sites autorisés à intégrer l'appli en iframe et à recevoir les scores
# (https uniquement, séparés par des virgules). Vide = aucune intégration externe.
VITE_PARENT_ORIGINS=https://www.mon-club-echecs.fr

# Page « Données personnelles » : adresse de contact (facultatif, visible publiquement)
VITE_CONTACT_EMAIL=
# Lien vers le code source public (licence GPL), ex. https://github.com/…/chess-endgame-rush
VITE_SOURCE_URL=
